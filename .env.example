# Safe local-development examples. Copy this file to .env and change values if needed.
POSTGRES_DB=parking_management
POSTGRES_USER=parking_app
POSTGRES_PASSWORD=local_development_password
POSTGRES_PORT=5432

# Spring Boot database connection settings.
DATABASE_URL=jdbc:postgresql://localhost:5432/parking_management
DATABASE_USERNAME=parking_app
DATABASE_PASSWORD=local_development_password
